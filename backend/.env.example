NODE_ENV=development
PORT=4000

# Local Docker Postgres (see docker-compose.yml at the repo root)
DATABASE_URL=postgresql://onekawayan:onekawayan@localhost:5432/onekawayan

# Comma-separated. Add the deployed frontend origin before going live.
CORS_ORIGINS=http://localhost:5173

LOG_LEVEL=debug

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-me-with-64-hex-characters-minimum-32-chars
SESSION_TTL_DAYS=30

# Optional. Leave empty to report nothing. Never commit a real DSN.
SENTRY_DSN=
